
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v2cr",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
